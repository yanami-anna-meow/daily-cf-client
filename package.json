{
  "name": "daily-cf-client",
  "productName": "小羊肖恩的每日一题",
  "version": "0.3.24",
  "private": true,
  "description": "A desktop client for Yawn Sean's Daily CF Problems.",
  "homepage": "https://github.com/yanami-anna-meow/daily-cf-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanami-anna-meow/daily-cf-client.git"
  },
  "bugs": {
    "url": "https://github.com/yanami-anna-meow/daily-cf-client/issues"
  },
  "author": "Daily CF Client contributors",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:corpus": "node scripts/audit-corpus.mjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run dist -- --win --x64 --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "highlight.js": "11.11.2",
    "isomorphic-git": "1.43.2",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    },
    "katex": "$katex"
  },
  "build": {
    "appId": "io.dailycf.client",
    "productName": "小羊肖恩的每日一题",
    "directories": {
      "output": "release",
      "buildResources": "docs/assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "dist-electron/library-worker.cjs",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "icon": "docs/assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Daily-CF-${version}-${arch}-nsis.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Daily-CF-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "icon": "docs/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "artifactName": "Daily-CF-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "docs/assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "artifactName": "Daily-CF-${version}-linux-${arch}.${ext}",
      "maintainer": "Daily CF Client contributors"
    }
  }
}
